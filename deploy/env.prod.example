# 生产环境变量示例（复制为 .env 或在 systemd/docker 中注入）
# 启动命令: java -jar hr-management.jar --spring.profiles.active=prod

SPRING_PROFILES_ACTIVE=prod
SERVER_PORT=8080

SPRING_DATASOURCE_URL=jdbc:mysql://127.0.0.1:3306/hr_management?useUnicode=true&characterEncoding=utf8&serverTimezone=Asia/Shanghai&useSSL=true
SPRING_DATASOURCE_USERNAME=hr_app
SPRING_DATASOURCE_PASSWORD=change-me

# 至少 32 字符，生产环境务必更换
JWT_SECRET=replace-with-a-long-random-secret-at-least-32-chars
JWT_EXPIRATION=86400000

# 前端访问地址（与 Nginx 对外域名一致）
APP_CORS_ORIGIN=https://your-domain.com
