# 复制为 deploy/.env 后修改
# cp .env.example .env

# 前端仓库路径（一键更新脚本会构建并拷到 frontend-dist）
# Windows 示例: D:/vue/vue-vben-admin-main
# Linux 示例:   /opt/vue-vben-admin-main
FRONTEND_PATH=D:/vue/vue-vben-admin-main

# MySQL
MYSQL_ROOT_PASSWORD=ChangeMe_Root_2026!
MYSQL_DATABASE=hr_management
MYSQL_USER=hr_app
MYSQL_PASSWORD=ChangeMe_App_2026!

# 后端
JWT_SECRET=ChangeMe_JwtSecret_AtLeast32Characters!!
JWT_EXPIRATION=86400000
# 用公网 IP + HTTPS 访问时填下面；有域名再改成 https://你的域名
APP_CORS_ORIGIN=https://39.105.67.125

# 阿里云 OSS（头像/文档/附件；不配则相关上传功能会失败）
ALIYUN_ACCESS_KEY_ID=
ALIYUN_ACCESS_KEY_SECRET=
ALIYUN_OSS_ENDPOINT=oss-cn-beijing.aliyuncs.com
ALIYUN_OSS_BUCKET=funk1
ALIYUN_OSS_PUBLIC_DOMAIN=funk1.oss-cn-beijing.aliyuncs.com
