# 复制为 deploy/.env 后修改
# cp .env.example .env   (Linux/macOS)
# copy .env.example .env (Windows)

# MySQL
MYSQL_ROOT_PASSWORD=root123456
MYSQL_DATABASE=hr_management
MYSQL_USER=hr_app
MYSQL_PASSWORD=hr123456

# 后端
JWT_SECRET=hr-docker-jwt-secret-change-me-32chars!!
JWT_EXPIRATION=86400000
APP_CORS_ORIGIN=http://localhost

# 前端源码目录（用于 start 脚本构建，按本机路径修改）
# Windows 示例: FRONTEND_PATH=D:/vue/vue-vben-admin-main
# Linux  示例: FRONTEND_PATH=../vue-vben-admin-main
FRONTEND_PATH=D:/vue/vue-vben-admin-main
